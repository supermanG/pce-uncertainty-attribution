#!/usr/bin/env bash
# Entry point of the Code Ocean compute capsule; also runs locally with `bash run`.
#
# Reproduces, from the result files committed under results/cluster_results/, every
# main-text figure of "Interpretable attribution of decision-relevant uncertainty in AI"
# (Nature Machine Intelligence, 2026), and runs the unit tests of the PCE core. Needs
# numpy, scipy, scikit-learn, matplotlib and pytest only: no GPU, no dataset download, no
# retraining.
# About one minute on one CPU core.
#
# On Code Ocean the repository is imported into /code (so this file is /code/run, the
# capsule entry point) and outputs go to /results; anywhere else they go to results/capsule/.
# codeocean/ holds the capsule environment (Dockerfile) and metadata record.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"

if [ -d /results ] && [ -w /results ]; then OUT=/results; else OUT="$PWD/results/capsule"; fi
mkdir -p "$OUT"
export MPLBACKEND=Agg
PY="$(command -v python3 || command -v python)"
export SOURCE_DATE_EPOCH=1789603200   # pins the PDF timestamps, so reruns are byte-identical

echo "== 1/2  unit tests of the PCE core (tests/)"
"$PY" -m pytest tests -q 2>&1 | tee "$OUT/pytest.txt"

echo "== 2/2  main-text figures from the committed results (figures/make_figures.py)"
"$PY" figures/make_figures.py 2>&1 | tee "$OUT/make_figures.txt"
for f in fig_framework fig_bh_revised fig_bh_closedloop fig_bo_oed fig_rlhf fig_voi; do
    cp "figures/$f.pdf" "$OUT/$f.pdf"
done
( cd "$OUT" && sha256sum *.pdf > sha256.txt )

echo
echo "Done. Outputs in $OUT:"
ls -1 "$OUT"
